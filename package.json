{
  "name": "learnhub",
  "version": "0.1.9",
  "description": "集成学习中心 - 大学生学习科研一体化桌面应用（模块化架构）",
  "main": "./out/main/index.js",
  "author": "LearnHub",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test:security": "node --experimental-strip-types --test tests/security-validation.test.mjs",
    "test:reader": "node --experimental-strip-types --test tests/reader-location.test.mjs tests/reader-request.test.mjs",
    "test:reader-learning": "node --test tests/reader-learning-contract.test.mjs",
    "test:research": "node --experimental-strip-types --test tests/research-search.test.mjs tests/research-actions.test.mjs tests/serial-queue.test.mjs",
    "test:todos": "node --experimental-strip-types --test tests/todo-persistence.test.mjs tests/todo-creation.test.mjs",
    "test:module-nav": "node --experimental-strip-types --test tests/module-navigation.test.mjs tests/module-lifecycle.test.mjs tests/module-filesystem.test.mjs",
    "test:achievement": "node --experimental-strip-types --test tests/achievement-claim.test.mjs tests/module-task-registration.test.mjs",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml && node scripts/clean-release.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@xyflow/react": "^12.3.5",
    "dayjs": "^1.11.13",
    "katex": "^0.16.11",
    "koffi": "^3.3.3",
    "pdfjs-dist": "^4.10.38",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
